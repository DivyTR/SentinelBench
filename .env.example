# How SentinelBench authenticates to Log Analytics:
#   managed_identity  on the lab VM built by infra/terraform (no secrets)
#   azure_cli         uses your `az login` session
#   client_secret     app registration; also set the three variables below
SENTINEL_AUTH=managed_identity
SENTINEL_WORKSPACE_ID=your-workspace-id

# Only for SENTINEL_AUTH=client_secret
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

POLL_INTERVAL_MINUTES=2
MAX_WAIT_MINUTES=15

# Where Atomic Red Team lives on the lab VM
ART_ATOMICS_DIR=C:\AtomicRedTeam\atomics
ART_MODULE_PATH=C:\AtomicRedTeam\invoke-atomicredteam\Invoke-AtomicRedTeam.psd1
